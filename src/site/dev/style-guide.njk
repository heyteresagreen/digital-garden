  .style-guide .sg-fonts { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1.25rem; }
  .style-guide .sg-fonts p { margin: 0; font-size: 2rem; line-height: 1.2; }
  .style-guide .sg-font-serif { font-family: var(--font-family); }
  .style-guide .sg-font-sans { font-family: var(--font-family-sans-serif); }
  .style-guide .sg-radius { width: 64px; height: 48px; background: var(--color-accent); border-radius: var(--border-radius); }
  /* the homepage section breaks out of the reading column to its real width */
  .style-guide .sg-wide { width: min(1120px, 100vw - 2rem); margin-left: 50%; transform: translateX(-50%); }
