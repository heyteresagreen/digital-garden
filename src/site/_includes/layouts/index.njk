---
# The shared layout for section index pages (Writing, Art, Letters…).
# A section page is mostly front matter; these options pick the look:
#   listClass          CSS class on the list: writing-list, notes-list,
#                      letters-list, art-grid, posts-mosaic (styles in
#                      _components.scss) — the main styling hook
#   showImages         cards get thumbnails (from each note's image:)
#   bodyImageFallback  …or the first picture in the note if it has none
#   showSections       cards show their section in small capitals
#   hideExcerpts       no summary text on cards
#   hideImageSections  sections whose cards never show a picture
#   intro              a line under the heading
#   titleImage(+Alt)   a picture instead of the text heading (Letters)
#   pagination.size    posts per page
# Anything written below a section page's front matter appears between the
# heading and the list.
layout: layouts/base.njk
---
{% from "components/post-card.njk" import postCard %}
{% from "components/pagination.njk" import pager %}
<header class="index-header">
  {#- titleImage in front matter swaps the text heading for a picture
      (the Letters page's hand-lettering); the alt text keeps it a heading #}
  {%- if titleImage %}
  <h1 class="index-title-image"><img src="{{ titleImage }}" alt="{{ titleImageAlt or title }}" loading="eager"></h1>
  {%- else %}
  <h1>{{ title }}</h1>
  {%- endif %}
  {%- if intro %}<p class="index-intro">{{ intro }}</p>{% endif %}
</header>
{{ content | safe }}
{%- if pagination.items.length %}
<ul class="post-list {{ listClass }}">
  {%- for post in pagination.items %}
  {{ postCard(post, { showImage: showImages, showSection: showSections, hideExcerpt: hideExcerpts, hideImageSections: hideImageSections, bodyImageFallback: bodyImageFallback }) }}
  {%- endfor %}
</ul>
{%- else %}
<p class="index-empty">Nothing here yet — check back soon.</p>
{%- endif %}
{{ pager(pagination) }}
