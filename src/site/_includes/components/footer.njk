{#- Footer links come from site.footer in _data/site.json. Entries with an
    empty url are skipped, so a link can be staged before it's ready. -#}
{%- set icons = {
  "rss": '<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1" fill="currentColor"/></svg>',
  "youtube": '<svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2C.5 9.1.5 12 .5 12s0 2.9.5 4.8a3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-4.8.5-4.8s0-2.9-.5-4.8zM9.7 15.5v-7l6 3.5-6 3.5z"/></svg>',
  "instagram": '<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/></svg>',
  "linkedin": '<svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M20.4 2H3.6C2.7 2 2 2.7 2 3.6v16.8c0 .9.7 1.6 1.6 1.6h16.8c.9 0 1.6-.7 1.6-1.6V3.6c0-.9-.7-1.6-1.6-1.6zM8 19H5V9.5h3V19zM6.5 8.2a1.7 1.7 0 1 1 0-3.5 1.7 1.7 0 0 1 0 3.5zM19 19h-3v-4.6c0-1.1 0-2.5-1.5-2.5s-1.8 1.2-1.8 2.4V19h-3V9.5h2.9v1.3c.4-.8 1.4-1.5 2.9-1.5 3 0 3.6 2 3.6 4.6V19z"/></svg>'
} %}
<footer>
  <a class="footer-home" href="/"><img src="/favicon.png" alt="{{ site.title }} — home" width="64" height="64"></a>
  {#- site links on the left, external profiles as their own group pushed
      to the right #}
  {%- for group in [{ external: false, label: "More" }, { external: true, label: "Elsewhere" }] %}
  <ul class="footer-links{% if group.external %} footer-social{% endif %}" aria-label="{{ group.label }}">
    {%- for item in site.footer %}{% if item.url and ("://" in item.url) == group.external %}
    {#- socials are icon-only; the label moves to aria-label/title -#}
    {%- if group.external and item.icon %}
    <li><a href="{{ item.url }}" rel="me noopener" aria-label="{{ item.label }}" title="{{ item.label }}">{{ icons[item.icon] | safe }}</a></li>
    {%- else %}
    <li><a href="{{ item.url }}"{% if group.external %} rel="me noopener"{% endif %}>{% if item.icon %}{{ icons[item.icon] | safe }}{% endif %}{{ item.label }}</a></li>
    {%- endif %}
    {%- endif %}{% endfor %}
  </ul>
  {%- endfor %}
</footer>
