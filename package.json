{
    "name": "teresawatts-com",
    "version": "2.0.0",
    "description": "teresawatts.com — custom Eleventy site (replaces Digital Garden plugin)",
    "scripts": {
        "start": "npm-run-all build:sass --parallel watch:*",
        "watch:sass": "sass --watch src/site/styles:dist/styles",
        "watch:eleventy": "cross-env ELEVENTY_ENV=dev eleventy --serve",
        "build:eleventy": "cross-env ELEVENTY_ENV=prod eleventy",
        "build:sass": "sass src/site/styles:dist/styles --style compressed",
        "build": "npm-run-all build:sass build:eleventy"
    },
    "author": "Teresa Watts",
    "license": "ISC",
    "devDependencies": {
        "@11ty/eleventy": "^3.0.0",
        "@11ty/eleventy-plugin-rss": "^2.0.2",
        "cross-env": "^7.0.3",
        "netlify-plugin-cache": "^1.0.3",
        "npm-run-all": "^4.1.5",
        "sass": "1.77.8"
    },
    "dependencies": {
        "@11ty/eleventy-img": "^6.0.4",
        "@sindresorhus/slugify": "^1.1.2",
        "gray-matter": "^4.0.3",
        "luxon": "^3.4.4",
        "markdown-it": "^14.1.0",
        "markdown-it-anchor": "^9.0.1",
        "markdown-it-attrs": "^4.1.6",
        "markdown-it-footnote": "^4.0.0",
        "markdown-it-task-checkbox": "^1.0.6"
    },
    "engines": {
        "node": ">=18"
    }
}
