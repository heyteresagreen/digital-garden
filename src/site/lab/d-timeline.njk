---
title: D · Timeline
---
{#- One narrow column, everything mixed in date order and grouped by month,
    each kind with its own look: art big, letters as envelopes, books as
    small covers. Reads like a sketchbook/journal. #}
{%- from "components/lab.njk" import hero, streamItem, book %}
{{ hero() }}

{%- set reading = "reading" | shelfCards | head(3) %}
<p class="lab-d-reading">
  Currently reading
  {%- for b in reading %} <a href="{{ b.url }}">{{ b.data.title }}</a>{% if not loop.last %}{% if loop.revindex == 2 %} and{% else %},{% endif %}{% endif %}{% endfor %}.
</p>

{%- set feed = collections.allPosts | head(16) %}
<div class="lab-d-feed">
{%- for post in feed %}
  {%- set m = post.date | dateFormat | replace(r/^\d+ /, "") %}
  {%- set prev = (feed[loop.index0 - 1].date | dateFormat | replace(r/^\d+ /, "")) if not loop.first else "" %}
  {%- if m != prev %}
  {%- if not loop.first %}</ul>{% endif %}
  <h2 class="lab-d-month">{{ m }}</h2>
  <ul class="lab-stream">
  {%- endif %}
  {{ streamItem(post, { showSection: true, bookCovers: true }) }}
{%- endfor %}
  </ul>
</div>
<a class="lab-button" href="/posts/page/2/">Older &rarr;</a>
