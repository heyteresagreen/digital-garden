  .style-guide .sg-h { margin: 4rem 0 0.5rem; padding-top: 1rem; border-top: 2px solid var(--color-primary); font-family: var(--font-family-sans-serif); font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-text); }
  .style-guide .sg-sub { margin: 2.5rem 0 1rem; font-family: var(--font-family-sans-serif); font-size: 0.8rem; font-weight: 600; color: var(--color-text); letter-spacing: 0; }
  .style-guide .sg-note { font-family: var(--font-family-sans-serif); font-size: 0.8rem; line-height: 1.5; margin-bottom: 1.5rem; }
  .style-guide .sg-frame { margin: 0 0 1.5rem; padding: 0 1.5rem; border: 1px dashed rgba(0, 0, 0, 0.15); border-radius: var(--border-radius); }
  .style-guide .sg-swatches { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 1.25rem; margin-bottom: 2rem; }
  .style-guide .sg-swatch, .style-guide .sg-fonts > div { display: flex; flex-direction: column; gap: 0.2rem; }
  .style-guide .sg-swatch code, .style-guide .sg-fonts code { font-size: 0.7rem; background: none; padding: 0; }
  .style-guide .sg-swatch small, .style-guide .sg-fonts small { font-family: var(--font-family-sans-serif); font-size: 0.7rem; line-height: 1.4; }
