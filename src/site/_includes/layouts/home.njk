{#- data-labels / data-letters: styles still being tried out for the card
    section labels and the letters sign-up (see lab.scss). Under npm start
    they can be switched live with the design options panel. -#}
{%- set homeOptions = { labels: "dark", letters: "cut" } -%}
<!doctype html>
<html lang="en" data-labels="{{ homeOptions.labels }}" data-letters="{{ homeOptions.letters }}"{% if build.dev %} data-defaults='{{ homeOptions | dump }}'{% endif %}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="{{ site.url }}/feed.xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles/tw-style.css?v={{ build.timestamp }}">
  {#- the homepage grew out of the lab (version E), so it still uses its styles #}
  <link rel="stylesheet" href="/styles/lab.css?v={{ build.timestamp }}">
  {%- if build.dev %}
  {#- dev only: apply options picked in the design options panel before
      anything draws #}
  <script>try { ["labels", "letters"].forEach(function (k) { var v = localStorage.getItem("opt-" + k); if (v) document.documentElement.dataset[k] = v; }); } catch (e) {}</script>
  {%- endif %}
</head>
<body class="lab lab-home">
  {#- torn-paper edges for the letters band (data-letters="torn"): ragged
      noise displacing the edges of a plain white box — the filter the old
      site used on its backlinks box -#}
  <svg width="0" height="0" style="position: absolute" aria-hidden="true">
    <filter id="torn-edge" x="-20%" y="-20%" width="140%" height="140%">
      <feTurbulence type="fractalNoise" baseFrequency="0.025" numOctaves="4" seed="25" result="noise"/>
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="10" xChannelSelector="R" yChannelSelector="G"/>
    </filter>
  </svg>
  {% include "components/nav.njk" %}
  <main class="lab-main">
{{ content | safe }}
  </main>
  {% include "components/footer.njk" %}
  {%- if build.dev %}{% include "components/design-options.njk" %}{% endif %}
  <script data-goatcounter="https://teresawatts.goatcounter.com/count"
          async src="//gc.zgo.at/count.js"></script>
</body>
</html>
