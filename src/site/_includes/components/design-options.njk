{#- Dev only (npm start): a little panel for trying homepage options live —
    currently the card section labels and the letters band. Each choice sets
    data-labels / data-letters on <html> (styles in lab.scss) and
    is remembered in this browser. Production uses the defaults written on
    <html> in layouts/home.njk; once you've picked, change them there. -#}
{%- set designOptions = [
  { key: "labels", label: "Labels", values: ["dark", "tag", "tag-caps", "pink"] },
  { key: "letters", label: "Letters", values: ["cut", "torn"] }
] %}
<div class="design-options" aria-label="Design options (dev only)">
  {%- for opt in designOptions %}
  <label>{{ opt.label }}
    <select data-opt="{{ opt.key }}">
      {%- for v in opt.values %}<option>{{ v }}</option>{% endfor %}
    </select>
  </label>
  {%- endfor %}
  <button type="button" class="design-options-reset" title="Back to the defaults">Reset</button>
</div>
<script>
  (function () {
    var root = document.documentElement;
    var defaults = JSON.parse(root.dataset.defaults || "{}");
    document.querySelectorAll(".design-options select").forEach(function (sel) {
      var key = sel.dataset.opt;
      sel.value = root.dataset[key];
      sel.addEventListener("change", function () {
        root.dataset[key] = sel.value;
        try { localStorage.setItem("opt-" + key, sel.value); } catch (e) {}
      });
    });
    document.querySelector(".design-options-reset").addEventListener("click", function () {
      Object.keys(defaults).forEach(function (k) { try { localStorage.removeItem("opt-" + k); } catch (e) {} });
      location.reload();
    });
  })();
</script>
