{#- Letters sign-up panel: the hand-lettered "Letters from Teresa", a short
    blurb and the Buttondown form, on a torn-paper panel. Styles in
    _components.scss (LETTERS SIGN-UP).

    Set before including:
      signupLayout   "stacked" (one centred column — the homepage) or
                     "two" (lettering and blurb left, form right)
      signupAtEnd    true when it's the last thing before the footer, so the
                     footer tucks up under it (homepage, single letters)
      signupNoTitle  true to leave out the lettering (the Letters page, where
                     it's the page heading instead)
      signupNoPast   true to leave out "Read past letters" (the Letters page)
      signupBlurb    to replace the standard blurb text -#}
{%- from "components/lab.njk" import more %}
{#- the torn edge: ragged noise displacing the edges of the panel's wash —
    the filter the old site used on its backlinks box -#}
<svg width="0" height="0" style="position: absolute" aria-hidden="true">
  <filter id="torn-edge" x="-20%" y="-20%" width="140%" height="140%">
    <feTurbulence type="fractalNoise" baseFrequency="0.025" numOctaves="4" seed="25" result="noise"/>
    <feDisplacementMap in="SourceGraphic" in2="noise" scale="10" xChannelSelector="R" yChannelSelector="G"/>
  </filter>
</svg>
<section class="letters-signup is-{{ signupLayout or 'two' }}{% if signupAtEnd %} is-end{% endif %}{% if signupNoTitle %} is-untitled{% endif %}" aria-label="Get my letters">
  {#- shown 260px wide by CSS; no width attribute here, or the image
      transform would shrink the file to 260px and it'd go soft on retina
      screens #}
  {%- if not signupNoTitle %}
  <h2 class="letters-signup-title"><img src="/img/user/assets/Letters.png" alt="Letters from Teresa"></h2>
  {%- endif %}
  <p class="letters-signup-blurb">{{ signupBlurb or "Letters from me to you, delivered very infrequently. Rambling thoughts, things I’ve made, interesting links." }}</p>
  <div class="letters-signup-form signup-form">
    <label for="bd-email">Your email address</label>
    <form action="https://buttondown.email/api/emails/embed-subscribe/Teresa" method="post" target="popupwindow" onsubmit="window.open('https://buttondown.email/Teresa', 'popupwindow')">
      <input type="email" name="email" id="bd-email" autocomplete="email" required>
      <button type="submit">Sign up</button>
    </form>
    {%- if not signupNoPast %}
    {{ more("/letters/", "Read past letters") }}
    {%- endif %}
  </div>
</section>
