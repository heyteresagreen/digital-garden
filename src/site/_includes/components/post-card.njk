{% macro postCard(post, opts = {}) %}
{%- set thumb = null %}
{%- if opts.showImage %}{% set thumb = post | cardImageAny if opts.bodyImageFallback else post | cardImage %}{% endif %}
{%- if opts.hideImageSections and post.data.section in opts.hideImageSections %}{% set thumb = null %}{% endif %}
<li class="post-card{% if thumb %} has-thumb{% endif %}">
  {%- if thumb %}
  <a class="post-card-thumb" href="{{ post.url }}">
    <img src="{{ thumb.src }}" alt="{{ thumb.alt or post.data.title }}" loading="lazy">
  </a>
  {%- endif %}
  <div class="post-card-body">
    {%- if opts.showSection and post.data.section %}
    <span class="post-card-section">{{ post.data.section }}</span>
    {%- endif %}
    <a class="post-card-title" href="{{ post.url }}">{{ post.data.title }}</a>
    {%- set summary = post | postExcerpt %}
    {%- if summary and not opts.hideExcerpt %}
    <p class="post-card-excerpt">{{ summary }}</p>
    {%- endif %}
    {%- if post.date %}
    <time datetime="{{ post.date | isoDate }}" class="posted">{{ post.date | dateFormat }}</time>
    {%- endif %}
  </div>
</li>
{% endmacro %}
