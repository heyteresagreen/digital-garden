    .ds-nav ul { display: contents; }
    .ds-nav-title, .ds-nav-group { display: none; }
    .ds-nav a { border-left: 0; border-bottom: 2px solid transparent; }
    .ds-nav a[aria-current] { border-bottom-color: var(--color-primary); }
