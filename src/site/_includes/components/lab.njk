{#- Building blocks shared by the homepage experiments in src/site/lab/ #}

{% macro hero(compact = false) %}
<section class="lab-hero{% if compact %} is-compact{% endif %}">
  <div class="lab-hero-text">
    <h1>Hi there!</h1>
    <p>I’m a UX designer &amp; artist, who sometimes <a href="/writing/">writes</a>, makes <a href="/art/">art</a>, <a href="/sketching/">sketches</a> and other fun things. You might be interested in what I'm up to <a href="/now/">Now</a>.</p>
  </div>
  <img class="lab-portrait" src="/img/user/assets/portraitv2.png" alt="Illustrated self-portrait of Teresa Watts">
</section>
{% endmacro %}

{#- Roomier intro: big portrait, big type, and a "Lately" line pulled from
    the Now page (pass it in — macros can't see collections) #}
{% macro heroBig(nowPage) %}
<section class="lab-hero-big">
  <img class="lab-portrait" src="/img/user/assets/portraitv2.png" alt="Illustrated self-portrait of Teresa Watts">
  <div class="lab-hero-text">
    <h1>Hi there!</h1>
    <p class="lab-hero-lede">I’m a UX designer &amp; artist, who sometimes <a href="/writing/">writes</a>, makes <a href="/art/">art</a>, <a href="/sketching/">sketches</a> and other fun things.</p>
    {%- if nowPage %}
    <p class="lab-hero-now"><a href="/now/"><span>Lately{% if nowPage.data.updated %} · {{ nowPage.data.updated | dayFormat }}{% endif %}</span></a>{{ nowPage | postExcerpt | replace("Here's what I'm up to right now: ", "") }}</p>
    {%- endif %}
    <p class="lab-hero-links"><a href="/about/">More about me &rarr;</a> <a href="/letters/">Get my letters &rarr;</a></p>
  </div>
</section>
{% endmacro %}

{% macro envelope() %}<svg class="lab-envelope" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><rect x="3" y="5.5" width="18" height="13" rx="1.5"/><path d="M3.5 6.5 12 13l8.5-6.5"/></svg>{% endmacro %}

{#- Kind of post, for type-specific styling in mixed lists #}
{% macro kind(post) -%}
{%- set s = post.data.section | primarySection -%}
{%- if s == "letters" %}letter{% elif s in ["art", "sketching", "sketchbooks", "projects"] %}making{% elif s == "books" %}book{% elif s == "notes" %}note{% else %}writing{% endif -%}
{%- endmacro %}

{#- One entry in a mixed "everything" stream: the look depends on the kind #}
{% macro streamItem(post, opts = {}) %}
{%- set k = kind(post) %}
{%- set sectionLabels = { writing: "Writing", notes: "Notes", art: "Art", sketching: "Sketching", sketchbooks: "Sketchbook", books: "Book", letters: "Letter", projects: "Project" } %}
{%- set thumb = post | cardImageAny %}
<li class="lab-item is-{{ k }}">
  {%- if k == "letter" %}
  <a class="lab-letter" href="{{ post.url }}">
    {{ envelope() }}
    <span><strong>{{ post.data.title }}</strong>{% if not opts.short %}<span class="lab-excerpt">{{ post | postExcerpt }}</span>{% endif %}</span>
  </a>
  <time class="lab-date">{{ post.date | dateFormat }}</time>
  {%- else %}
  <time class="lab-date">{{ post.date | dateFormat }}{% if opts.showSection %} · {{ sectionLabels[post.data.section | primarySection] }}{% endif %}</time>
  <a class="lab-title" href="{{ post.url }}">{{ post.data.title }}</a>
  {%- if thumb and k == "book" and opts.bookCovers %}
  <a class="lab-cover" href="{{ post.url }}"><img src="{{ thumb.src }}" alt="{{ thumb.alt or post.data.title }}" loading="lazy"{% if thumb.remote %} eleventy:ignore{% endif %}></a>
  {%- elif thumb and k != "book" %}
  <a class="lab-thumb" href="{{ post.url }}"><img src="{{ thumb.src }}" alt="{{ thumb.alt or post.data.title }}" loading="lazy"{% if thumb.remote %} eleventy:ignore{% endif %}></a>
  {%- endif %}
  {%- set summary = post | postExcerpt %}
  {%- if summary and k != "making" %}<p class="lab-excerpt">{{ summary }}</p>{% endif %}
  {%- endif %}
</li>
{% endmacro %}

{#- Image tile: art, sketches, sketchbooks. --r is the image's real
    width÷height, which .lab-jrow uses to size it without cropping #}
{% macro tile(post, showTitle = true) %}
{%- set thumb = post | cardImageAny %}
<a class="lab-tile" href="{{ post.url }}"{% if thumb %} style="--r: {{ thumb.src | imageRatio }}"{% endif %}>
  {%- if thumb %}<img src="{{ thumb.src }}" alt="{{ thumb.alt or post.data.title }}" loading="lazy"{% if thumb.remote %} eleventy:ignore{% endif %}>{% endif %}
  {%- if showTitle %}<span>{{ post.data.title }}</span>{% endif %}
</a>
{% endmacro %}

{#- A book cover with title under it #}
{% macro book(post, label = "") %}
{%- set thumb = post | cardImage %}
<a class="lab-book" href="{{ post.url }}">
  {%- if thumb %}<img src="{{ thumb.src }}" alt="{{ thumb.alt or post.data.title }}" loading="lazy"{% if thumb.remote %} eleventy:ignore{% endif %}>{% else %}<span class="lab-book-blank">{{ post.data.title }}</span>{% endif %}
  <span class="lab-book-text">{% if label %}<em>{{ label }}</em>{% endif %}{{ post.data.title }}</span>
</a>
{% endmacro %}

{#- A story card (E, B3): image, small section label, serif title,
    optional excerpt, date. Sized by its container's classes in lab.scss;
    --r (the image's width÷height) is there for rows that keep real shapes.
    showImage = false (or no image at all) gives a text-only card;
    useTag = true labels it with its first tag instead of its section #}
{% macro storyCard(post, cls = "", excerpt = false, showImage = true, useTag = false) %}
{%- set labels = { writing: "Writing", notes: "Notes", art: "Art", sketching: "Sketching", sketchbooks: "Sketchbook", projects: "Project" } %}
{%- set section = post.data.section | primarySection %}
{#- useTag: label with the post's first tag that isn't just its section
    (falls back to the section) #}
{%- set tagged = [] %}
{%- if useTag %}{% for t in post.data.tags or [] %}{% if t != section and t != "not-writing" %}{% set tagged = (tagged.push(t), tagged) %}{% endif %}{% endfor %}{% endif %}
{%- set thumb = (post | cardImageAny) if showImage else false %}
<article class="lab-e-card {{ cls }}{% if not thumb %} is-text{% endif %}"{% if thumb %} style="--r: {{ thumb.src | imageRatio }}"{% endif %}>
  {%- if thumb %}<a class="lab-e-img" href="{{ post.url }}" tabindex="-1"><img src="{{ thumb.src }}" alt="{{ thumb.alt or post.data.title }}" loading="lazy"{% if thumb.remote %} eleventy:ignore{% endif %}></a>{% endif %}
  <div class="lab-e-text">
    {#- the label links to its tag's page, or its section's #}
    <p class="lab-e-tag">
      {%- if tagged[0] %}<a href="{{ tagged[0] | tagUrl }}">{{ tagged[0] }}</a>
      {%- else %}<a href="/{{ section or "writing" }}/">{{ labels[section] or "Writing" }}</a>{% endif -%}
    </p>
    <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
    {%- if excerpt %}<p class="lab-e-excerpt">{{ post | postExcerpt }}</p>{% endif %}
    <time class="lab-e-date">{{ post.date | dateFormat }}</time>
  </div>
</article>
{% endmacro %}

{% macro more(url, text) %}<a class="lab-more" href="{{ url }}">{{ text }} &rarr;</a>{% endmacro %}
