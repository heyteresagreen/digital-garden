---
# /posts/ — everything, newest first, as a mosaic. Index page options
# (listClass, showImages…) are explained in _includes/layouts/index.njk.
layout: layouts/index.njk
title: Posts
contentClass: wide
pagination:
  data: collections.allPosts
  size: 12
  generatePageOnEmptyData: true
permalink: "/posts/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber + 1 }}/{% endif %}"
showSections: true
showImages: true
hideImageSections: ["books"]
listClass: posts-mosaic
eleventyExcludeFromCollections: true
---
<ul class="tag-links">
  {%- for s in [
    { label: "Art", url: "/art/" },
    { label: "Reading", url: "/reading/" },
    { label: "Letters", url: "/letters/" },
    { label: "Notes", url: "/notes/" },
    { label: "Sketchbooks", url: "/sketchbooks/" },
    { label: "Sketching", url: "/sketching/" },
    { label: "Writing", url: "/writing/" }
  ] %}
  <li><a href="{{ s.url }}">{{ s.label }}</a></li>
  {%- endfor %}
</ul>
