{#- One post in a list (postCard macro), used by every index page and tag
    page. opts switch parts on and off — see the options in
    layouts/index.njk. Styles: .post-card and the list classes in
    _components.scss. -#}
{% macro postCard(post, opts = {}) %}
{%- set thumb = null %}
{%- if opts.showImage %}{% set thumb = post | cardImageAny if opts.bodyImageFallback else post | cardImage %}{% endif %}
{%- if opts.hideImageSections and post.data.section in opts.hideImageSections %}{% set thumb = null %}{% endif %}
{#- link: in a note's front matter sends the card somewhere other than the
    note (a tool's card opens the tool) #}
{%- set href = post.data.link or post.url %}
<li class="post-card{% if thumb %} has-thumb{% endif %}">
  {%- if thumb %}
  <a class="post-card-thumb" href="{{ href }}">
    <img src="{{ thumb.src }}" alt="{{ thumb.alt or post.data.title }}" loading="lazy"{% if thumb.remote %} eleventy:ignore{% endif %}>
  </a>
  {%- endif %}
  <div class="post-card-body">
    {%- if opts.showSection and post.data.section %}
    <span class="post-card-section">{{ post.data.section }}</span>
    {%- endif %}
    <a class="post-card-title" href="{{ href }}">{{ post.data.title }}</a>
    {%- set summary = post | postExcerpt %}
    {%- if summary and not opts.hideExcerpt %}
    <p class="post-card-excerpt">{{ summary }}</p>
    {%- endif %}
    {%- if post.date and not opts.hideDate %}
    <time datetime="{{ post.date | isoDate }}" class="posted">{{ post.date | dateFormat }}</time>
    {%- endif %}
    {%- if opts.button %}
    <a class="post-card-button" href="{{ href }}">{{ opts.button }}</a>
    {%- endif %}
  </div>
</li>
{% endmacro %}
