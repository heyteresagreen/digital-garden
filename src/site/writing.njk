---
# /writing/ — longer posts (with thumbnails from the first picture in a
# post if it has no image:). Index page options are explained in
# _includes/layouts/index.njk.
layout: layouts/index.njk
title: Writing
intro: Longer-form posts about design, art, tools and process.
pagination:
  data: collections.writing
  size: 12
  generatePageOnEmptyData: true
permalink: "/writing/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber + 1 }}/{% endif %}"
showImages: true
bodyImageFallback: true
listClass: writing-list
eleventyExcludeFromCollections: true
---
