---
title: A · Wireframe
---
{#- Straight from the 4 Jan 2026 sketch: intro + portrait, then a stream of
    posts on the left and Making / Reading down the right. Art lives only in
    the right column, so the left stream is words: writing, letters, notes. #}
{%- from "components/lab.njk" import hero, streamItem, tile, book, more %}
{{ hero() }}

<div class="lab-a-cols">
  <section class="lab-a-stream">
    <h2 class="lab-h">Latest posts</h2>
    <ul class="lab-stream">
      {%- for post in collections.allPosts | notInSections(making.concat(["books"])) | head(6) %}
      {{ streamItem(post) }}
      {%- endfor %}
    </ul>
    <a class="lab-button" href="/posts/">Next page &rarr;</a>
  </section>

  <aside class="lab-a-side">
    <section>
      <h2 class="lab-h">Making</h2>
      {%- for post in collections.allPosts | inSections(making) | head(3) %}
      {{ tile(post) }}
      {%- endfor %}
      {{ more("/art/", "All art") }}
    </section>
    <section>
      <h2 class="lab-h">Reading</h2>
      {%- for b in "reading" | shelfCards | head(1) %}
      {{ book(b, "Reading now") }}
      {%- endfor %}
      {{ more("/reading/", "Bookshelf") }}
    </section>
  </aside>
</div>
