<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title and page.url != "/" %}{{ title }} — {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="{{ site.url }}/feed.xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles/tw-style.css?v={{ build.timestamp }}">
  {#- extra stylesheets a page asks for by name, e.g. extraStyles: [lab]
      on the style guide, which shows the homepage's components too #}
  {%- for sheet in extraStyles or [] %}
  <link rel="stylesheet" href="/styles/{{ sheet }}.css?v={{ build.timestamp }}">
  {%- endfor %}
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
  {% include "components/nav.njk" %}
  <div class="wrapper">
    <main class="content{% if contentClass %} {{ contentClass }}{% endif %}">
{{ content | safe }}
      {#- every page ends with the letters sign-up, just above the footer —
          except pages that already have it (hideSignup: true, e.g. the
          Letters page). The homepage has its own layout and version. #}
      {%- if not hideSignup %}
      {%- set signupLayout = "two" %}
      {%- set signupAtEnd = true %}
      {% include "components/letters-signup.njk" %}
      {%- endif %}
    </main>
  </div>
  {% include "components/footer.njk" %}
  <script data-goatcounter="https://teresawatts.goatcounter.com/count"
          async src="//gc.zgo.at/count.js"></script>
</body>
</html>
