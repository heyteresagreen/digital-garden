<nav class="navbar" aria-label="Main">
  <a id="logo" class="internal-link" href="/"><img src="{{ site.logo.src }}" alt="{{ site.logo.alt }}"></a>
  <ul id="topnav">
    {%- for item in site.nav %}
    {#- active on the page itself, anything under it, and the sections in
        the list named by `alsoSections` (Making: sections.making) #}
    {%- set isActive = false %}
    {%- set prefixes = [item.url] %}
    {%- for sec in sections[item.alsoSections] or [] %}{% set prefixes = (prefixes.push("/" + sec + "/"), prefixes) %}{% endfor %}
    {%- for prefix in prefixes %}
    {%- if page.url and (page.url == prefix or (prefix != "/" and page.url.startsWith(prefix))) %}{% set isActive = true %}{% endif %}
    {%- endfor %}
    <li><a href="{{ item.url }}"{% if isActive %} class="active" aria-current="page"{% endif %}>{{ item.label }}</a></li>
    {%- endfor %}
  </ul>
</nav>
